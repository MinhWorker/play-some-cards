    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/websockets": "^12.1.0",
    "@psc/shared": "*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
