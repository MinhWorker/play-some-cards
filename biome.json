{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!.release-please-manifest.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["games/**", "scripts/templates/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@xomdao/sdk",
                      "!@xomdao/sdk/client",
                      "!phaser",
                      "!zod",
                      "!vitest",
                      "!./**",
                      "!../*",
                      "!../*/**"
                    ],
                    "message": "A game may import only @xomdao/sdk, @xomdao/sdk/client, phaser, zod, vitest (tests) and its own files (./..., ../game/...)."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Stay inside your game's src/ (folders one level deep, e.g. src/game/ and src/scenes/)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["games/co-ty-phu-classic/src/scenes/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@xomdao/sdk",
                      "!@xomdao/sdk/client",
                      "!phaser",
                      "!zod",
                      "!vitest",
                      "!./**",
                      "!../**",
                      "!../../**"
                    ],
                    "message": "A game may import only the SDK, Phaser, zod, vitest and its own source files."
                  },
                  {
                    "group": ["../../../**"],
                    "message": "Stay inside this game's src/ when importing from a nested scene folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**", "packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@xomdao/game-*", "**/games/*/src/**"],
                    "message": "Core code reaches games only through the generated list (@xomdao/shared `games`) and apps/web/src/games/index.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
