{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!.release-please-manifest.json"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["games/**", "scripts/game-template/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!@psc/sdk",
                      "!@psc/sdk/client",
                      "!phaser",
                      "!zod",
                      "!vitest",
                      "!./**",
                      "!../*"
                    ],
                    "message": "A game may import only @psc/sdk, @psc/sdk/client, phaser, zod, vitest (tests) and its own files (./...)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/**", "packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@psc/game-*", "**/games/*/src/**"],
                    "message": "Core code reaches games only through the generated list (@psc/shared `games`) and apps/web/src/games/index.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
