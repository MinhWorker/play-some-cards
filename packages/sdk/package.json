{
  "name": "@psc/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Everything a game plugin may use: rules contract, rng helpers, test helpers, and (in /client) the board scene base class.",
  "exports": {
    ".": {
      "psc-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
