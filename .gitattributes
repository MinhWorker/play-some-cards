# Source art and audio (assets/) are stored with Git LFS: install it once with `git lfs install`.
# App-ready files in apps/web/public/ stay in plain git (small, and the hosts build from them).
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.psd filter=lfs diff=lfs merge=lfs -text
assets/**/*.kra filter=lfs diff=lfs merge=lfs -text
assets/**/*.aseprite filter=lfs diff=lfs merge=lfs -text
assets/**/*.svg filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/**/*.flac filter=lfs diff=lfs merge=lfs -text
# Each game's originals (games/<id>/sources/); its app-ready assets/ stay in plain git.
games/*/sources/**/*.png filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.jpg filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.psd filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.kra filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.aseprite filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.wav filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.ogg filter=lfs diff=lfs merge=lfs -text
games/*/sources/**/*.flac filter=lfs diff=lfs merge=lfs -text
