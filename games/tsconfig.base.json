{
  "$comment": "Type checking for a game folder (its rules: src/index.ts and src/game). Each game's tsconfig.json extends this.",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["xomdao-source"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true
  },
  "include": ["${configDir}/src"]
}
